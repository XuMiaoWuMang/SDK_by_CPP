{
  "comment": "AIChatServer 配置模板。编写说明见同目录《配置说明.md》; 复制本文件为 env.conf 后按需修改; 未找到 env.conf 时程序使用内置默认值启动。",
  "server": {
    "ip": "0.0.0.0",
    "port": 8080,
    "log_level": "INFO",
    "log_file": "logs",
    "data_dir": "data"
  },
  "temperature": 0.7,
  "max_tokens": 2048,
  "models": [
    {
      "provider": "deepseek",
      "name": "deepseek-v4-flash",
      "api_key": "",
      "desc": "DeepSeek 通用对话模型"
    },
    {
      "provider": "deepseek",
      "name": "deepseek-r1",
      "temperature": 0.5,
      "max_tokens": 4096,
      "desc": "DeepSeek 推理模型"
    },
    {
      "provider": "gemini",
      "name": "gemini-3.5-flash",
      "api_key": "",
      "desc": "Gemini 云端模型"
    },
    {
      "provider": "chatgpt",
      "name": "gpt-3.5-turbo",
      "api_key": "",
      "desc": "ChatGPT 云端模型"
    },
    {
      "provider": "ollama",
      "name": "deepseek-r1:1.5b",
      "endpoint": "http://127.0.0.1:11434",
      "desc": "本地 Ollama 推理模型"
    },
    {
      "provider": "ollama",
      "name": "llama3.1:8b",
      "endpoint": "http://127.0.0.1:11434",
      "desc": "本地 Ollama 通用模型"
    }
  ]
}
